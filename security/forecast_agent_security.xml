<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_tommasi_forecast" model="res.groups">
        <field name="name">Forecast</field>
        <field name="category_id" eval="False" />
        <field name="implied_ids" eval="[(5, 0, 0)]" />
        <field
            name="comment"
        >See the Forecast menu in Inventory and run or review forecast agent jobs.</field>
    </record>
    <record id="tommasi_forecast_agent_config_company_rule" model="ir.rule">
        <field name="name">Forecast Agent Config: multi-company</field>
        <field name="model_id" ref="model_tommasi_forecast_agent_config" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('llm.group_llm_manager')), (4, ref('group_tommasi_forecast'))]"
        />
    </record>
    <record id="tommasi_forecast_agent_run_company_rule" model="ir.rule">
        <field name="name">Forecast Agent Run: multi-company</field>
        <field name="model_id" ref="model_tommasi_forecast_agent_run" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('llm.group_llm_manager')), (4, ref('group_tommasi_forecast'))]"
        />
    </record>
</odoo>
