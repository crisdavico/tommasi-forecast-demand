<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tommasi_forecast_agent_config_company_rule" model="ir.rule">
        <field name="name">Forecast Agent Config: multi-company</field>
        <field name="model_id" ref="model_tommasi_forecast_agent_config" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('llm.group_llm_manager'))]" />
    </record>
    <record id="tommasi_forecast_agent_run_company_rule" model="ir.rule">
        <field name="name">Forecast Agent Run: multi-company</field>
        <field name="model_id" ref="model_tommasi_forecast_agent_run" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('llm.group_llm_manager'))]" />
    </record>
</odoo>
